{
  "name": "@wci-tech/graph-ui-premium",
  "author": "Wealthcraft Innovations Pvt. Ltd.",
  "license": "UNLICENSED",
  "version": "0.0.1",
  "private": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/wci-tech/graph-ui.git"
  },
  "type": "module",
  "main": "build/index.cjs",
  "module": "build/index.js",
  "types": "build/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "import": "./build/index.js",
      "require": "./build/index.cjs",
      "default": "./build/index.js"
    }
  },
  "files": ["build", "README.md", "LICENSE"],
  "scripts": {
    "commit": "node scripts/commit.mjs",
    "clean": "rimraf build dist coverage",
    "cypress:open": "cypress open --component",
    "cypress:run:component": "cypress run --component",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "lint": "eslint . --ext ts,tsx --max-warnings=0",
    "lint:fix": "eslint . --ext ts,tsx --fix",
    "format:check": "prettier . --check",
    "format:fix": "prettier . --write",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:coverage:watch": "vitest --coverage",
    "build-storybook": "storybook build --config-dir ./.storybook",
    "storybook": "storybook dev --config-dir ./.storybook -p 6006",
    "build:lib": "tsup",
    "build": "run-s clean typecheck lint build:lib",
    "ci": "yarn build",
    "changeset": "changeset",
    "publish:dummy": "node scripts/publishDummy.mjs"
  },
  "dependencies": {
    "canvas-confetti": "^1.9.4",
    "chart.js": "^4.5.0",
    "chartjs-adapter-date-fns": "^3.0.0",
    "chartjs-chart-financial": "^0.2.1",
    "chartjs-chart-funnel": "^4.2.5",
    "chartjs-chart-graph": "^4.3.5",
    "chartjs-chart-matrix": "^3.0.4",
    "chartjs-chart-treemap": "^4.1.1",
    "chartjs-plugin-datalabels": "^2.2.0",
    "date-fns": "^4.4.0",
    "echarts": "^6.0.0",
    "libphonenumber-js": "^1.12.39",
    "swiper": "^12.1.2",
    "uplot": "^1.6.31"
  },
  "peerDependencies": {
    "@wci-tech/core-ui-premium": "1.4.3-test-1792500953302",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "react": ">=19 <20",
    "react-dom": ">=19 <20"
  },
  "devDependencies": {
    "@wci-tech/core-ui-premium": "1.4.3-test-1792500953302",
    "@changesets/cli": "^2.27.7",
    "@chromatic-com/storybook": "^5.2.1",
    "@cypress/react": "^9.0.1",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@eslint/js": "^9.39.2",
    "@storybook/addon-a11y": "^10.2.16",
    "@storybook/addon-docs": "^10.2.16",
    "@storybook/addon-links": "^10.2.16",
    "@storybook/react": "^10.2.16",
    "@storybook/react-vite": "^10.2.16",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20.16.5",
    "@types/react": "19.2.3",
    "@types/react-dom": "19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.48.1",
    "@typescript-eslint/parser": "^8.48.1",
    "@vitejs/plugin-react": "^4.6.0",
    "@vitest/coverage-v8": "^4.1.9",
    "cypress": "14.4.0",
    "cypress-axe": "^1.7.0",
    "cypress-storybook": "^1.0.0",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsonc": "^2.10.0",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-unused-imports": "^4.3.0",
    "husky": "^9.1.6",
    "jsdom": "^29.1.1",
    "lint-staged": "^15.2.7",
    "next": "16.1.6",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.3.2",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-international-phone": "^4.8.0",
    "rimraf": "^5.0.7",
    "storybook": "^10.2.16",
    "tsup": "^8.5.1",
    "typescript": "5.6.3",
    "typescript-eslint": "^8.65.0",
    "vite": "5.4.10",
    "vitest": "^4.0.16"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs}": ["eslint --fix", "prettier --write"],
    "*.{json,md,yml,yaml}": ["prettier --write"]
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "packageManager": "yarn@1.22.22",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com/",
    "access": "restricted"
  }
}
